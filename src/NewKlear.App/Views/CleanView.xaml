<UserControl x:Class="NewKlear.App.Views.CleanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="36,48,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Clean" Style="{StaticResource Nk.PageTitle}" />
                <TextBlock Text="Remove temporary files, caches and leftovers. Your documents, photos and browser logins are never touched." Style="{StaticResource Nk.PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource Nk.SecondaryButton}" Command="{Binding ScanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Search24" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Scan" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Nk.PrimaryButton}" Margin="10,0,0,0" Command="{Binding CleanCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Broom24" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Clean selected" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Summary bar -->
        <Border Grid.Row="1" Style="{StaticResource Nk.Card}" Margin="0,20,0,14" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,28,0">
                    <TextBlock Text="SELECTED" Style="{StaticResource Nk.Overline}" />
                    <TextBlock Text="{Binding SelectedBytesText}" FontFamily="{StaticResource Nk.DisplayFont}" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource Nk.Accent}" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding StatusText}" FontSize="13.5" Foreground="{DynamicResource Nk.Text}" TextTrimming="CharacterEllipsis" />
                    <ProgressBar Style="{StaticResource Nk.Progress}" Value="{Binding Progress}" Margin="0,10,0,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Button Style="{StaticResource Nk.GhostButton}" Content="Recommended" Command="{Binding SelectRecommendedCommand}" />
                    <Button Style="{StaticResource Nk.GhostButton}" Content="None" Command="{Binding SelectNoneCommand}" />
                    <Button Style="{StaticResource Nk.GhostButton}" Content="Stop" Command="{Binding CancelCommand}" Foreground="{DynamicResource Nk.Danger}"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Groups -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="0,0,-12,0" Padding="0,0,12,0">
            <ItemsControl ItemsSource="{Binding Groups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Nk.Card}" Padding="8" Margin="0,0,0,12">
                            <StackPanel>
                                <!-- Group header -->
                                <Grid Margin="8,6,10,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Nk.CheckBox}" IsChecked="{Binding AllSelected}" IsThreeState="False" />
                                    <TextBlock Grid.Column="1" Text="{Binding Name}" Style="{StaticResource Nk.SectionTitle}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding TotalText}" FontWeight="SemiBold" Foreground="{DynamicResource Nk.Accent}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                    <ToggleButton Grid.Column="3" IsChecked="{Binding IsExpanded}" Cursor="Hand" Background="Transparent" BorderThickness="0" Padding="6" FocusVisualStyle="{x:Null}">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent" Padding="6">
                                                    <ui:SymbolIcon x:Name="Chevron" Symbol="ChevronRight24" FontSize="16" Foreground="{DynamicResource Nk.TextMuted}" RenderTransformOrigin="0.5,0.5">
                                                        <ui:SymbolIcon.RenderTransform><RotateTransform x:Name="Rot" Angle="0" /></ui:SymbolIcon.RenderTransform>
                                                    </ui:SymbolIcon>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="Chevron" Property="RenderTransform">
                                                            <Setter.Value><RotateTransform Angle="90" /></Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                </Grid>

                                <!-- Items -->
                                <ItemsControl ItemsSource="{Binding Items}" Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Nk.Row}" Margin="0,1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <CheckBox Style="{StaticResource Nk.CheckBox}" IsChecked="{Binding IsSelected}" IsEnabled="{Binding IsAvailable}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Nk.ItemTitle}" />
                                                            <Border Style="{StaticResource Nk.Pill}" Background="{DynamicResource Nk.WarningSoft}" Margin="8,0,0,0"
                                                                    Visibility="{Binding IsCaution, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Caution" Style="{StaticResource Nk.PillText}" Foreground="{DynamicResource Nk.Warning}" />
                                                            </Border>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Nk.Muted}" Margin="0,3,0,0" />
                                                        <TextBlock Text="{Binding Warning}" Style="{StaticResource Nk.Muted}" Foreground="{DynamicResource Nk.Warning}" Margin="0,3,0,0"
                                                                   Visibility="{Binding Warning, Converter={StaticResource HasValueToVis}}" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" MinWidth="110">
                                                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" HorizontalAlignment="Right"
                                                                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                                        <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontWeight="SemiBold" FontSize="14"
                                                                   Visibility="{Binding IsBusy, Converter={StaticResource InverseBoolToVis}}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Nk.TextMuted}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding HasSize}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Nk.Text}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Text="{Binding ResultText}" HorizontalAlignment="Right" FontSize="11.5" Foreground="{DynamicResource Nk.Success}" Margin="0,2,0,0"
                                                                   TextWrapping="Wrap" MaxWidth="220" TextAlignment="Right"
                                                                   Visibility="{Binding ResultText, Converter={StaticResource HasValueToVis}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
