<UserControl x:Class="NewKlear.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid Margin="36,48,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Startup apps" Style="{StaticResource Nk.PageTitle}" />
                <TextBlock Text="Fewer apps at startup means a faster sign-in. Turning an app off doesn't uninstall it — it just stops it launching with Windows." Style="{StaticResource Nk.PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource Nk.GhostButton}" Content="Open Task Manager" Command="{Binding OpenTaskManagerCommand}" />
                <Button Style="{StaticResource Nk.SecondaryButton}" Margin="10,0,0,0" Command="{Binding RefreshCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <UniformGrid Grid.Row="1" Columns="2" Margin="-6,18,-6,12" HorizontalAlignment="Left" Width="460">
            <Border Style="{StaticResource Nk.Card}" Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="STARTING WITH WINDOWS" Style="{StaticResource Nk.Overline}" />
                    <TextBlock Text="{Binding EnabledCount}" Style="{StaticResource Nk.BigNumber}" Foreground="{DynamicResource Nk.Accent}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Nk.Card}" Margin="6" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="DISABLED" Style="{StaticResource Nk.Overline}" />
                    <TextBlock Text="{Binding DisabledCount}" Style="{StaticResource Nk.BigNumber}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Nk.Card}" Padding="8">
            <Grid>
                <ui:ProgressRing IsIndeterminate="True" Width="42" Height="42" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Nk.Row}" Margin="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource Nk.Surface2}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Nk.Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" Style="{StaticResource Nk.ItemTitle}" />
                                                <TextBlock Text="{Binding Publisher}" Style="{StaticResource Nk.Muted}" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Command}" Style="{StaticResource Nk.Muted}" FontSize="11.5" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Command}" />
                                            <TextBlock Text="{Binding SourceLabel}" Style="{StaticResource Nk.Muted}" FontSize="11" Opacity="0.75" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Style="{StaticResource Nk.GhostButton}" Command="{Binding OpenLocationCommand}" ToolTip="Open file location" Margin="0,0,10,0">
                                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" />
                                        </Button>
                                        <ui:ToggleSwitch Grid.Column="3" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanChange}" VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
