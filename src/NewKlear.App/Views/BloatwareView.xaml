<UserControl x:Class="NewKlear.App.Views.BloatwareView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:bloat="clr-namespace:NewKlear.Core.Bloat;assembly=NewKlear.Core">
    <Grid Margin="36,48,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Bloatware" Style="{StaticResource Nk.PageTitle}" />
                <TextBlock Text="{Binding StatusText}" Style="{StaticResource Nk.PageSubtitle}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
                <Button Style="{StaticResource Nk.SecondaryButton}" Command="{Binding LoadCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Nk.PrimaryButton}" Margin="10,0,0,0" Command="{Binding RemoveSelectedCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Delete24" FontSize="16" Margin="0,0,8,0" />
                        <TextBlock><Run Text="Remove selected (" /><Run Text="{Binding SelectedCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Copilot callout -->
        <Border Grid.Row="1" Style="{StaticResource Nk.Card}" Margin="0,20,0,0" Padding="18,14" BorderBrush="{DynamicResource Nk.Accent}"
                Background="{DynamicResource Nk.AccentSofter}" Visibility="{Binding HasCopilot, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Nk.IconTile}"><ui:SymbolIcon Symbol="Bot24" FontSize="20" Foreground="{DynamicResource Nk.Accent}" /></Border>
                <StackPanel Grid.Column="1" Margin="14,0" VerticalAlignment="Center">
                    <TextBlock Text="Copilot is installed" Style="{StaticResource Nk.ItemTitle}" />
                    <TextBlock Text="Remove the Copilot apps in one click. To also block Windows Copilot by policy, turn on 'Turn off Windows Copilot' in Optimize → Privacy." Style="{StaticResource Nk.Muted}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Nk.GhostButton}" Content="Open privacy settings" Command="{Binding OpenCopilotTweakCommand}" />
                    <Button Style="{StaticResource Nk.SecondaryButton}" Content="Remove Copilot" Margin="8,0,0,0" Command="{Binding RemoveCopilotCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Filters -->
        <Grid Grid.Row="2" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox PlaceholderText="Search apps" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Icon="{ui:SymbolIcon Search24}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                <RadioButton Style="{StaticResource Nk.Chip}" Content="All" GroupName="bloatFilter" IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=all}" />
                <RadioButton Style="{StaticResource Nk.Chip}" Content="Recommended" GroupName="bloatFilter" IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=recommended}" />
                <RadioButton Style="{StaticResource Nk.Chip}" Content="Optional" GroupName="bloatFilter" IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=optional}" />
                <RadioButton Style="{StaticResource Nk.Chip}" Content="Copilot &amp; AI" GroupName="bloatFilter" IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=copilot}" />
                <RadioButton Style="{StaticResource Nk.Chip}" Content="Unlisted" GroupName="bloatFilter" IsChecked="{Binding Filter, Converter={StaticResource EqualsToBool}, ConverterParameter=unlisted}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Style="{StaticResource Nk.GhostButton}" Content="Select recommended" Command="{Binding SelectRecommendedCommand}" />
                <Button Style="{StaticResource Nk.GhostButton}" Content="None" Command="{Binding SelectNoneCommand}" />
            </StackPanel>
        </Grid>

        <!-- List -->
        <Border Grid.Row="3" Style="{StaticResource Nk.Card}" Padding="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="10,6,10,8">
                    <ui:ToggleSwitch IsChecked="{Binding ShowProtected}" Content="Show apps NewKlear recommends keeping" FontSize="12.5" Foreground="{DynamicResource Nk.TextMuted}" />
                    <ui:ToggleSwitch IsChecked="{Binding AlsoDeprovision}" IsEnabled="{Binding IsAdmin}" Margin="24,0,0,0"
                                     Content="Also remove for new user accounts" FontSize="12.5" Foreground="{DynamicResource Nk.TextMuted}" />
                </StackPanel>
                <ui:ProgressRing Grid.Row="1" IsIndeterminate="True" Width="42" Height="42" VerticalAlignment="Center" HorizontalAlignment="Center"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                <ListBox Grid.Row="1" ItemsSource="{Binding Apps}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.ScrollUnit="Pixel">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <ContentPresenter />
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Nk.Row}" Margin="0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Style="{StaticResource Nk.CheckBox}" IsChecked="{Binding IsSelected}" VerticalAlignment="Top" Margin="0,2,8,0" />
                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Nk.ItemTitle}" />
                                            <TextBlock Text="{Binding PackageName}" Style="{StaticResource Nk.Muted}" FontSize="11" Margin="10,0,0,0" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource Nk.Muted}" Margin="0,3,0,0" />
                                        <TextBlock Text="{Binding Status}" Style="{StaticResource Nk.Muted}" Foreground="{DynamicResource Nk.Danger}" Margin="0,3,0,0"
                                                   Visibility="{Binding Status, Converter={StaticResource HasValueToVis}}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                        <Border Margin="0,0,6,0" Visibility="{Binding IsCopilot, Converter={StaticResource BoolToVis}}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Nk.Pill}">
                                                    <Setter Property="Background" Value="{DynamicResource Nk.AccentSoft}" />
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="AI" Style="{StaticResource Nk.PillText}" Foreground="{DynamicResource Nk.Accent}" />
                                        </Border>
                                        <Border>
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource Nk.Pill}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Tag}" Value="{x:Static bloat:BloatTag.Recommended}">
                                                            <Setter Property="Background" Value="{DynamicResource Nk.AccentSoft}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Tag}" Value="{x:Static bloat:BloatTag.Protected}">
                                                            <Setter Property="Background" Value="{DynamicResource Nk.SuccessSoft}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding TagText}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Nk.PillText}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Tag}" Value="{x:Static bloat:BloatTag.Recommended}">
                                                                <Setter Property="Foreground" Value="{DynamicResource Nk.Accent}" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Tag}" Value="{x:Static bloat:BloatTag.Protected}">
                                                                <Setter Property="Foreground" Value="{DynamicResource Nk.Success}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>
    </Grid>
</UserControl>
