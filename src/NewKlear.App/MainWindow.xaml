<ui:FluentWindow x:Class="NewKlear.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vm="clr-namespace:NewKlear.App.ViewModels"
                 Title="NewKlear" Width="1320" Height="860" MinWidth="1060" MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="None" WindowCornerPreference="Round"
                 Background="{DynamicResource Nk.Bg}" Foreground="{DynamicResource Nk.Text}"
                 Icon="pack://application:,,,/Assets/icon256.png"
                 FontFamily="{StaticResource Nk.TextFont}">
    <Grid Background="{DynamicResource Nk.Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Sidebar ================= -->
        <Border Grid.Column="0" Background="{DynamicResource Nk.Sidebar}" BorderBrush="{DynamicResource Nk.Border}" BorderThickness="0,0,1,0">
            <DockPanel Margin="14,46,14,14">
                <!-- Brand tile: always dark so the logo looks right in every theme -->
                <Border DockPanel.Dock="Top" CornerRadius="16" Background="#050506" Padding="14,12" Margin="0,0,0,22"
                        BorderBrush="#26FF6A00" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Image Source="pack://application:,,,/Assets/mark.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                            <Image Source="pack://application:,,,/Assets/wordmark.png" Height="20" HorizontalAlignment="Left" RenderOptions.BitmapScalingMode="HighQuality" />
                            <TextBlock Text="CLEAN · OPTIMIZE · BOOST" FontSize="8.5" Foreground="#9D9DA8" Margin="2,5,0,0" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Footer: admin status -->
                <Border DockPanel.Dock="Bottom" CornerRadius="10" Padding="12,10" Margin="0,10,0,0" Background="{DynamicResource Nk.Surface}"
                        BorderBrush="{DynamicResource Nk.Border}" BorderThickness="1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding IsAdmin, Converter={StaticResource BoolToVis}}">
                            <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="18" Foreground="{DynamicResource Nk.Success}" />
                            <TextBlock Text="Running as administrator" FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Nk.TextMuted}" />
                        </StackPanel>
                        <StackPanel Visibility="{Binding IsAdmin, Converter={StaticResource InverseBoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon Symbol="Warning24" FontSize="18" Foreground="{DynamicResource Nk.Warning}" />
                                <TextBlock Text="Limited mode" FontSize="12" FontWeight="SemiBold" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Nk.Text}" />
                            </StackPanel>
                            <TextBlock Text="Some items need administrator rights." Style="{StaticResource Nk.Muted}" FontSize="11.5" Margin="0,4,0,6" />
                            <Button Content="Restart as admin" Style="{StaticResource Nk.SecondaryButton}" Padding="10,5" MinHeight="30" FontSize="12" Command="{Binding RestartAsAdminCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox DockPanel.Dock="Bottom" ItemsSource="{Binding FooterItems}" SelectedItem="{Binding SelectedFooter}"
                         ItemContainerStyle="{StaticResource Nk.NavItem}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="Icon" Symbol="{Binding Icon}" FontSize="20" Foreground="{DynamicResource Nk.TextMuted}" />
                                <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Nk.TextMuted}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Nk.Accent}" />
                                    <Setter TargetName="Icon" Property="Filled" Value="True" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Nk.Text}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Rectangle DockPanel.Dock="Bottom" Height="1" Fill="{DynamicResource Nk.Border}" Margin="6,8" />

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}"
                         ItemContainerStyle="{StaticResource Nk.NavItem}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <ui:SymbolIcon x:Name="Icon" Symbol="{Binding Icon}" FontSize="20" Foreground="{DynamicResource Nk.TextMuted}" />
                                <TextBlock x:Name="Label" Text="{Binding Title}" FontSize="14" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Nk.TextMuted}" />
                            </StackPanel>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Nk.Accent}" />
                                    <Setter TargetName="Icon" Property="Filled" Value="True" />
                                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource Nk.Text}" />
                                    <Setter TargetName="Label" Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ================= Content ================= -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" />

        <!-- Title bar (drag area + window buttons) -->
        <ui:TitleBar Grid.Column="0" Grid.ColumnSpan="2" VerticalAlignment="Top" Height="40" Title="" ShowHelp="False"
                     ButtonsForeground="{DynamicResource Nk.Text}" />

        <!-- Toast -->
        <Border Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,28,24" MaxWidth="460"
                CornerRadius="12" Padding="16,12" Background="{DynamicResource Nk.Surface2}" BorderThickness="1"
                Visibility="{Binding IsToastVisible, Converter={StaticResource BoolToVis}}">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="BorderBrush" Value="{DynamicResource Nk.Border}" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ToastKind}" Value="{x:Static vm:ToastKind.Success}">
                            <Setter Property="BorderBrush" Value="{DynamicResource Nk.Success}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding ToastKind}" Value="{x:Static vm:ToastKind.Error}">
                            <Setter Property="BorderBrush" Value="{DynamicResource Nk.Danger}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.35" Color="Black" />
            </Border.Effect>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ToastMessage}" TextWrapping="Wrap" FontSize="13.5" Foreground="{DynamicResource Nk.Text}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Style="{StaticResource Nk.GhostButton}" Margin="10,0,-6,0" Padding="6" Command="{Binding DismissToastCommand}">
                    <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" />
                </Button>
            </Grid>
        </Border>

        <ui:ContentDialogHost x:Name="DialogHost" Grid.Column="0" Grid.ColumnSpan="2" />
    </Grid>
</ui:FluentWindow>
