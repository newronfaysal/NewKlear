<UserControl x:Class="NewKlear.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <Grid Margin="36,48,36,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="History &amp; Undo" Style="{StaticResource Nk.PageTitle}" />
            <TextBlock Text="Everything NewKlear has changed on this PC. Settings and removed apps can be undone from here." Style="{StaticResource Nk.PageSubtitle}" />
        </StackPanel>

        <WrapPanel Grid.Row="1" Margin="0,18,0,14">
            <Button Style="{StaticResource Nk.SecondaryButton}" Command="{Binding CreateRestorePointCommand}" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="Create restore point" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Nk.SecondaryButton}" Command="{Binding OpenSystemRestoreCommand}" Margin="0,0,10,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowReset24" FontSize="16" Margin="0,0,8,0" />
                    <TextBlock Text="Open System Restore" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Nk.GhostButton}" Command="{Binding OpenLogsCommand}" Margin="0,0,6,0">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="DocumentText24" FontSize="16" Margin="0,0,6,0" />
                    <TextBlock Text="Logs folder" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Nk.GhostButton}" Command="{Binding OpenBackupsCommand}">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" Margin="0,0,6,0" />
                    <TextBlock Text="Registry backups" />
                </StackPanel>
            </Button>
        </WrapPanel>

        <Border Grid.Row="2" Style="{StaticResource Nk.Card}" Padding="8">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                    <ui:SymbolIcon Symbol="History24" FontSize="40" Foreground="{DynamicResource Nk.TextMuted}" HorizontalAlignment="Center" />
                    <TextBlock Text="Nothing here yet. Changes you make will appear in this list." Style="{StaticResource Nk.Muted}" Margin="0,10,0,0" />
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Items}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Nk.Row}" Margin="0,1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource Nk.IconTile}" Width="36" Height="36" VerticalAlignment="Top">
                                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="18" Foreground="{DynamicResource Nk.Accent}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="14,0,16,0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource Nk.ItemTitle}" />
                                                <Border Style="{StaticResource Nk.Pill}" Margin="8,0,0,0" Visibility="{Binding IsUndone, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="Undone" Style="{StaticResource Nk.PillText}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource Nk.Muted}" Margin="0,3,0,0" MaxHeight="40" TextTrimming="CharacterEllipsis"
                                                       Visibility="{Binding Detail, Converter={StaticResource HasValueToVis}}" />
                                            <TextBlock Text="{Binding TimeText}" Style="{StaticResource Nk.Muted}" FontSize="11" Opacity="0.75" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" Margin="0,0,10,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                                            <Button Style="{StaticResource Nk.SecondaryButton}" Padding="12,5" MinHeight="30"
                                                    Command="{Binding DataContext.UndoCommand, ElementName=Root}" CommandParameter="{Binding}"
                                                    Visibility="{Binding CanUndo, Converter={StaticResource BoolToVis}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="14" Margin="0,0,6,0" />
                                                    <TextBlock Text="Undo" />
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
