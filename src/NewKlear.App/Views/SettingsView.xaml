<UserControl x:Class="NewKlear.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             x:Name="Root">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,48,36,32" MaxWidth="1100" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource Nk.PageTitle}" />
            <TextBlock Text="Make NewKlear yours." Style="{StaticResource Nk.PageSubtitle}" />

            <!-- Themes -->
            <TextBlock Text="Theme" Style="{StaticResource Nk.SectionTitle}" Margin="0,26,0,4" />
            <TextBlock Text="Ember matches the NewKlear logo. The others keep the same layout with a different glow." Style="{StaticResource Nk.Muted}" Margin="0,0,0,12" />
            <ItemsControl ItemsSource="{Binding Themes}" Margin="-6,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Margin="6" Command="{Binding DataContext.SelectThemeCommand, ElementName=Root}" CommandParameter="{Binding}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Nk.CardButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource Nk.Accent}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <StackPanel>
                                <!-- Mini preview of the theme -->
                                <Border Height="78" CornerRadius="10" Background="{Binding Theme.PreviewBackground}" Padding="10" ClipToBounds="True">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="22" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <Border Height="6" CornerRadius="3" Background="{Binding Theme.PreviewAccent}" Margin="0,0,4,6" />
                                            <Border Height="6" CornerRadius="3" Background="{Binding Theme.PreviewSurface}" Margin="0,0,4,6" />
                                            <Border Height="6" CornerRadius="3" Background="{Binding Theme.PreviewSurface}" Margin="0,0,4,0" />
                                        </StackPanel>
                                        <Border Grid.Column="1" CornerRadius="6" Background="{Binding Theme.PreviewSurface}" Padding="8">
                                            <StackPanel>
                                                <Border Height="6" Width="44" CornerRadius="3" Background="{Binding Theme.PreviewText}" HorizontalAlignment="Left" Opacity="0.85" />
                                                <Border Height="16" Width="56" CornerRadius="5" Background="{Binding Theme.PreviewAccent}" HorizontalAlignment="Left" Margin="0,10,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,10,0,0">
                                    <TextBlock Text="{Binding Theme.Name}" Style="{StaticResource Nk.ItemTitle}" />
                                    <ui:SymbolIcon Symbol="CheckmarkCircle24" Filled="True" FontSize="18" Foreground="{DynamicResource Nk.Accent}" HorizontalAlignment="Right"
                                                   Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}" />
                                </Grid>
                                <TextBlock Text="{Binding Theme.Tagline}" Style="{StaticResource Nk.Muted}" FontSize="11.5" Margin="0,2,0,0" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Behaviour -->
            <TextBlock Text="Behaviour" Style="{StaticResource Nk.SectionTitle}" Margin="0,26,0,12" />
            <Border Style="{StaticResource Nk.Card}" Padding="8">
                <StackPanel>
                    <Border Style="{StaticResource Nk.Row}" Padding="14,12">
                        <Grid>
                            <StackPanel Margin="0,0,80,0">
                                <TextBlock Text="Include developer caches" Style="{StaticResource Nk.ItemTitle}" />
                                <TextBlock Text="Adds npm, Yarn/pnpm, pip, NuGet and VS Code caches to the Clean page." Style="{StaticResource Nk.Muted}" />
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding IncludeDeveloperCaches}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Nk.Row}" Padding="14,12">
                        <Grid>
                            <StackPanel Margin="0,0,80,0">
                                <TextBlock Text="Remove apps for new user accounts too" Style="{StaticResource Nk.ItemTitle}" />
                                <TextBlock Text="When removing bloatware, also stop Windows installing it for accounts created later. Needs administrator rights." Style="{StaticResource Nk.Muted}" />
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding DeprovisionAppsByDefault}" IsEnabled="{Binding IsAdmin}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Nk.Row}" Padding="14,12">
                        <Grid>
                            <StackPanel Margin="0,0,80,0">
                                <TextBlock Text="Offer a restore point before the first tweak" Style="{StaticResource Nk.ItemTitle}" />
                                <TextBlock Text="Asks once per session before changing any Windows setting." Style="{StaticResource Nk.Muted}" />
                            </StackPanel>
                            <ui:ToggleSwitch IsChecked="{Binding PromptRestorePoint}" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- About -->
            <TextBlock Text="About" Style="{StaticResource Nk.SectionTitle}" Margin="0,26,0,12" />
            <Border Style="{StaticResource Nk.Card}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="14" Background="#050506" Padding="6" Width="76" Height="76">
                        <Image Source="pack://application:,,,/Assets/icon256.png" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource Nk.ItemTitle}" FontSize="16"><Run Text="NewKlear " /><Run Text="{Binding Version, Mode=OneWay}" Foreground="{DynamicResource Nk.Accent}" /></TextBlock>
                        <TextBlock Text="Clean · Optimize · Boost for Windows 11" Style="{StaticResource Nk.Muted}" />
                        <TextBlock Style="{StaticResource Nk.Muted}" FontSize="11.5" Margin="0,4,0,0"><Run Text="Data, logs and backups: " /><Run Text="{Binding DataFolder, Mode=OneWay}" /></TextBlock>
                    </StackPanel>
                    <Button Grid.Column="2" Style="{StaticResource Nk.SecondaryButton}" Content="Open data folder" Command="{Binding OpenDataFolderCommand}" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
